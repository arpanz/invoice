	<key>NSPhotoLibraryUsageDescription</key>
	<string>Invoice Maker Pro needs access to your photo library to upload your business logo.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Invoice Maker Pro needs access to save invoice images to your photo library.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
